# Copy to .env for local development. "shopify app dev" fills SHOPIFY_API_KEY, SHOPIFY_API_SECRET,
# SHOPIFY_APP_URL and SCOPES by itself; set them yourself only in production.

# PostgreSQL connection. A free database from Neon, Supabase or Railway is fine. Use a NEW database (or at least a
# separate schema) for Reorder Desk: do not share the uploader's tables. With Neon, keep the long timeouts:
#   ...?sslmode=require&connect_timeout=30&pool_timeout=30
DATABASE_URL="postgresql://user:password@host:5432/restock?sslmode=require&connect_timeout=30&pool_timeout=30"

# File storage for uploaded supplier sheets and import reports.
# Production: Cloudflare R2 (set all four). Without R2_BUCKET, files go to STORAGE_DIR on local disk.
R2_BUCKET=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
STORAGE_DIR="./storage"
# Uploaded files are deleted after this many days
FILE_RETENTION_DAYS="7"

# Job queue. Production: Redis + the worker service (npm run worker), which also sends the alert emails and
# runs the 6-hourly sync. Without REDIS_URL, all of that runs inside the web server (fine for development).
REDIS_URL=""
WORKER_CONCURRENCY="4"
# Hours between automatic syncs of each store
SYNC_EVERY_HOURS="6"

# Email (weekly reorder email, low-stock alerts, purchase orders to suppliers) through Resend (resend.com).
# EMAIL_FROM must be on a domain verified in Resend, e.g. "Reorder Desk <orders@mail.yourdomain.com>".
# Without RESEND_API_KEY, emails are only written to the log.
RESEND_API_KEY=""
EMAIL_FROM=""

# SMS and WhatsApp alerts (Pro plan, 100 messages a month per store) through Twilio (twilio.com).
# TWILIO_SMS_FROM: a Twilio number "+1555..." or a Messaging Service id "MG...".
# TWILIO_WHATSAPP_FROM: the WhatsApp sender number; TWILIO_WHATSAPP_TEMPLATE: the approved Content template id "HX..."
# (Utility template with three values: {{1}} store name, {{2}} what needs ordering, {{3}} link to the app).
# Without the account id and token, messages are only written to the log. Each channel works on its own.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""
TWILIO_WHATSAPP_TEMPLATE=""

# Optional: Google service account for importing private Google Sheets.
# Paste the whole JSON key file on one line. Merchants share their sheet with its client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Shown on the public /privacy and /support pages
SUPPORT_EMAIL=""
# The app's handle in the Partner Dashboard: used for links to the app in emails and to Shopify's plan page
APP_HANDLE="reorder-desk"

# Production only (Shopify CLI sets these during development)
# SHOPIFY_API_KEY=""
# SHOPIFY_API_SECRET=""
# SHOPIFY_APP_URL="https://restock.example.com"
# SCOPES="read_products,write_inventory,read_locations,read_orders"
